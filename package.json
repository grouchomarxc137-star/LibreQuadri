{
  "name": "librequadri",
  "productName": "LibreQuadri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.build.json",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "prestart": "npm run build",
    "start": "electron .",
    "bootstrap:dev": "npm run build:main && node dist/scripts/bootstrap-dev.js",
    "import:metel": "npm run build:main && node dist/scripts/import-metel.js",
    "import:tiquadri": "npm run build:main && node dist/scripts/import-tiquadri.js",
    "import:tiquadri-drawings": "npm run build:main && node dist/scripts/import-tiquadri-drawings.js",
    "db:generate:lq": "drizzle-kit generate --config=drizzle.lq.config.ts",
    "db:generate:raw": "drizzle-kit generate --config=drizzle.raw.config.ts",
    "db:generate:project": "drizzle-kit generate --config=drizzle.project.config.ts",
    "db:manifest:project": "npm run build:main && node dist/scripts/project-manifest.js --write",
    "db:check:project-manifest": "npm run build:main && node dist/scripts/project-manifest.js",
    "prepare:alpha": "npm run build:main && node dist/scripts/prepare-alpha.js",
    "package:alpha": "npm run build && node dist/scripts/package-alpha.js",
    "prepare:alpha1": "npm run build:main && node dist/scripts/prepare-alpha.js --alpha1",
    "package:alpha1": "npm run build && node dist/scripts/package-alpha.js --alpha1",
    "prepare:alpha11": "npm run build:main && node dist/scripts/prepare-alpha.js --alpha11",
    "package:alpha11": "npm run build && node dist/scripts/package-alpha.js --alpha11",
    "prepare:beta1": "npm run build:main && node dist/scripts/prepare-beta.js",
    "package:beta1": "npm run build && node dist/scripts/package-alpha.js --beta1",
    "sync:engineering": "npm run build:main && node dist/scripts/sync-engineering.js",
    "import:sienergy": "npm run build:main && node dist/scripts/import-sienergy.js",
    "prepare:sienergy-drawings": "npm run build:main && node dist/scripts/prepare-sienergy-drawings.js",
    "audit:publication": "python3 scripts/audit-publication.py"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "mdb-reader": "3.2.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "electron": "44.10.2",
    "jsdom": "^29.1.1",
    "opentype.js": "^2.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
