{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "db/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts",
    "src/**/*.cts",
    "test/**/*.ts",
    "drizzle.*.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["src/renderer", "test/renderer"]
}
